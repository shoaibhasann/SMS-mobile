{
  "name": "sms-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/installations": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "SMS_BUILD_PLATFORM=ios expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@react-native-firebase/app",
          "@react-native-firebase/installations",
          "@react-native-firebase/messaging"
        ]
      }
    }
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
