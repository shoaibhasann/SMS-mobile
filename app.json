{
  "expo": {
    "name": "SMS",
    "slug": "sms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sms-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.iamshoaib.sms"
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sms-icon-adaptive.png",
        "backgroundColor": "#f7f9fd"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.iamshoaib.sms",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "./plugins/with-reminder-channel.js",
      "./plugins/with-splash-background.js",
      "./plugins/with-release-signing.js"
    ],
    "scheme": "sms-school"
  }
}
