{
  "expo": {
    "name": "SMS",
    "slug": "sms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sms-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.iamshoaib.sms"
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sms-icon.png",
        "backgroundColor": "#3867ff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.iamshoaib.sms",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "sms-school"
  }
}
